# Overleaf 登录账号。不要提交真实密码到 Git。
OVERLEAF_EMAIL=your-email@example.com
OVERLEAF_PASSWORD=change-me

# 宿主机上的论文源码同步目录。
SYNC_DIR=/data-12/M2023-WX/OverleafSync

# 保存 Web 面板“哪些项目需要备份”的选择状态。
STATE_DIR=./state

# 项目配置文件（不再需要填写 Project ID）。
CONFIG_FILE=./config.yml

# Web 管理面板端口。
WEB_PORT=30389
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# Docker 构建源。默认针对中国大陆网络优化。
# 如果国内源不可用，可改回官方源。
PYTHON_IMAGE=python:3.12-slim
DEBIAN_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
